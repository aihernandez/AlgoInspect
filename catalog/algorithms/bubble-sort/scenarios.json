{
  "algorithmId": "bubble-sort",
  "version": "1.0.0",
  "scenarios": [
    { "id": "empty", "description": { "es": "Colección vacía", "en": "Empty collection" }, "values": [], "expected": { "status": "sorted", "values": [], "comparisons": 0, "swaps": 0, "passes": 0, "terminatedEarly": false } },
    { "id": "single", "description": { "es": "Un elemento", "en": "Single element" }, "values": [5], "expected": { "status": "sorted", "values": [5], "comparisons": 0, "swaps": 0, "passes": 0, "terminatedEarly": false } },
    { "id": "sorted", "description": { "es": "Ya ordenado", "en": "Already sorted" }, "values": [1, 2, 3, 4], "expected": { "status": "sorted", "values": [1, 2, 3, 4], "comparisons": 3, "swaps": 0, "passes": 1, "terminatedEarly": true } },
    { "id": "reverse", "description": { "es": "Orden inverso", "en": "Reverse order" }, "values": [4, 3, 2, 1], "expected": { "status": "sorted", "values": [1, 2, 3, 4], "comparisons": 6, "swaps": 6, "passes": 3, "terminatedEarly": false } },
    { "id": "mixed", "description": { "es": "Valores mezclados", "en": "Mixed values" }, "values": [5, 1, 4, 2, 8], "expected": { "status": "sorted", "values": [1, 2, 4, 5, 8], "comparisons": 9, "swaps": 4, "passes": 3, "terminatedEarly": true } },
    { "id": "duplicates", "description": { "es": "Valores duplicados", "en": "Duplicate values" }, "values": [3, 1, 2, 1, 3], "expected": { "status": "sorted", "values": [1, 1, 2, 3, 3] } },
    { "id": "negatives", "description": { "es": "Valores negativos", "en": "Negative values" }, "values": [-1, -3, 2, 0], "expected": { "status": "sorted", "values": [-3, -1, 0, 2] } },
    { "id": "sorted-duplicates", "description": { "es": "Duplicados ya ordenados", "en": "Sorted duplicates" }, "values": [1, 1, 2, 2], "expected": { "status": "sorted", "values": [1, 1, 2, 2], "terminatedEarly": true } },
    { "id": "two-swapped", "description": { "es": "Dos elementos invertidos", "en": "Two swapped values" }, "values": [2, 1], "expected": { "status": "sorted", "values": [1, 2], "comparisons": 1, "swaps": 1, "passes": 1, "terminatedEarly": false } },
    { "id": "all-equal", "description": { "es": "Todos iguales", "en": "All equal" }, "values": [7, 7, 7], "expected": { "status": "sorted", "values": [7, 7, 7], "comparisons": 2, "swaps": 0, "passes": 1, "terminatedEarly": true } },
    { "id": "zero-crossing", "description": { "es": "Cruce por cero", "en": "Crossing zero" }, "values": [0, 3, -2, 1, -1], "expected": { "status": "sorted", "values": [-2, -1, 0, 1, 3] } }
  ]
}
