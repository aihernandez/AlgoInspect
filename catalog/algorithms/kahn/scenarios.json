{
  "algorithmId": "kahn",
  "version": "1.0.0",
  "scenarios": [
    {"id":"empty","vertices":[],"edges":[],"expected":{"status":"complete","order":[]}},
    {"id":"single","vertices":["A"],"edges":[],"expected":{"status":"complete","order":["A"]}},
    {"id":"isolated","vertices":["A","B","C"],"edges":[],"expected":{"status":"complete","order":["A","B","C"]}},
    {"id":"chain","vertices":["A","B","C","D"],"edges":[["A","B"],["B","C"],["C","D"]],"expected":{"status":"complete","order":["A","B","C","D"]}},
    {"id":"branching","vertices":["A","B","C","D","E","F"],"edges":[["A","B"],["A","C"],["B","D"],["C","E"],["D","F"],["E","F"]],"expected":{"status":"complete","emitsAll":true}},
    {"id":"disconnected","vertices":["A","B","C","D","E"],"edges":[["A","B"],["C","D"]],"expected":{"status":"complete","emitsAll":true}},
    {"id":"self-loop","vertices":["A"],"edges":[["A","A"]],"expected":{"status":"cycle","order":[],"blocked":["A"]}},
    {"id":"duplicate-edge","vertices":["A","B","C"],"edges":[["A","B"],["A","B"],["B","C"]],"expected":{"status":"complete","order":["A","B","C"]}},
    {"id":"dependencies","vertices":["A","B","C","D","E","F"],"edges":[["A","C"],["A","D"],["B","D"],["C","E"],["D","E"],["D","F"],["E","F"]],"expected":{"status":"complete","emitsAll":true}},
    {"id":"cycle","vertices":["A","B","C","D","E","F"],"edges":[["A","B"],["A","E"],["B","C"],["C","D"],["D","C"],["E","F"]],"expected":{"status":"cycle","order":["A","B","E","F"],"blocked":["C","D"]}}
  ]
}
