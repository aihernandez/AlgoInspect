<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\AlgorithmAnalysis.Contracts\AlgorithmAnalysis.Contracts.csproj" />
    <ProjectReference Include="..\..\Catalog\AlgorithmCatalog.Application\AlgorithmCatalog.Application.csproj" />
    <ProjectReference Include="..\..\Catalog\AlgorithmCatalog.Infrastructure.FileSystem\AlgorithmCatalog.Infrastructure.FileSystem.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\..\catalog\**\*"
             Link="catalog\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\apps\web\**\*"
             Link="web\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
